<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forzar HTTPS en producción si no es entorno local
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|::1)$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Bloquear acceso a directorios sensibles
    RewriteRule ^(logs|config|core|database)/ - [F,L]
    
    # 3. Bloquear acceso a archivos sensibles por extensión
    RewriteRule \.(log|ini|env|json|lock|md|sql|git|sh)$ - [F,L]

    # 4. Redirigir al Front Controller (index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?action=$1 [QSA,L]
</IfModule>

# Evitar listado de directorios
Options -Indexes
